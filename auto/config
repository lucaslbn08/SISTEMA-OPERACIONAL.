#!/bin/sh
set -e

. ./distro.conf

# Disponibiliza o nome do sistema para os hooks dentro do chroot
mkdir -p config/includes.chroot/usr/share/distro
cp distro.conf config/includes.chroot/usr/share/distro/distro.conf

lb config noauto \
	--distribution trixie \
	--architectures amd64 \
	--archive-areas "main contrib non-free non-free-firmware" \
	--mirror-bootstrap "http://deb.debian.org/debian/" \
	--mirror-chroot "http://deb.debian.org/debian/" \
	--mirror-binary "http://deb.debian.org/debian/" \
	--security true \
	--updates true \
	--debian-installer none \
	--binary-images iso-hybrid \
	--bootloaders "grub-efi grub-pc" \
	--firmware-chroot true \
	--firmware-binary true \
	--chroot-squashfs-compression-type xz \
	--iso-application "${DISTRO_NAME}" \
	--iso-publisher "${DISTRO_NAME}" \
	--iso-volume "${DISTRO_NAME} ${DISTRO_VERSION}" \
	--image-name "${DISTRO_ID}-${DISTRO_VERSION}" \
	--bootappend-live "boot=live components quiet splash locales=pt_BR.UTF-8 keyboard-layouts=br timezone=America/Sao_Paulo username=${DISTRO_ID} hostname=${DISTRO_ID} user-fullname=${DISTRO_NAME}" \
	"${@}"
