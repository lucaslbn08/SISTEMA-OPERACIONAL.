#!/bin/sh
set -e

. ./distro.conf

# Menu de boot do pendrive: parte dos modelos do live-build e inicia sozinho após 5 segundos
modelos=/usr/share/live/build/bootloaders/grub-pc
if [ -d "$modelos" ] && [ ! -d config/bootloaders/grub-pc ]; then
	mkdir -p config/bootloaders
	cp -r "$modelos" config/bootloaders/grub-pc
	printf '\nset timeout=5\n' >> config/bootloaders/grub-pc/config.cfg
	echo "Modelos do menu de boot:"
	find config/bootloaders/grub-pc -type f | sort
	for f in config/bootloaders/grub-pc/*.cfg; do echo "== $f"; cat "$f"; done
fi

lb config noauto \
	--distribution trixie \
	--architectures amd64 \
	--archive-areas "main contrib non-free non-free-firmware" \
	--mirror-bootstrap "http://deb.debian.org/debian/" \
	--mirror-chroot "http://deb.debian.org/debian/" \
	--mirror-binary "http://deb.debian.org/debian/" \
	--security true \
	--updates true \
	--debian-installer none \
	--binary-images iso-hybrid \
	--bootloaders "grub-efi grub-pc" \
	--firmware-chroot true \
	--firmware-binary true \
	--chroot-squashfs-compression-type xz \
	--iso-application "${DISTRO_NAME}" \
	--iso-publisher "${DISTRO_NAME}" \
	--iso-volume "${DISTRO_NAME} ${DISTRO_VERSION}" \
	--image-name "${DISTRO_ID}-${DISTRO_VERSION}" \
	--bootappend-live "boot=live components quiet splash locales=pt_BR.UTF-8 keyboard-layouts=br timezone=America/Sao_Paulo username=${DISTRO_ID} hostname=${DISTRO_ID} user-fullname=${DISTRO_NAME}" \
	"${@}"
