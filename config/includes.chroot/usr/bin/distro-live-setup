#!/bin/sh
# Só na sessão Live (pendrive): coloca o atalho do instalador na área de trabalho.
[ -d /run/live/medium ] || exit 0

origem=/usr/share/applications/install-debian.desktop
[ -f "$origem" ] || exit 0

pasta=$(xdg-user-dir DESKTOP 2>/dev/null || echo "$HOME/Desktop")
mkdir -p "$pasta"
cp "$origem" "$pasta/instalar.desktop"
chmod +x "$pasta/instalar.desktop"
