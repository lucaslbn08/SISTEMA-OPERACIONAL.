#!/bin/bash
# Identidade do pendrive e do instalador (Calamares).
set -eo pipefail

. /usr/share/distro/distro.conf

# O nome, o GRUB, o zram, o firewall etc. vêm do pacote distro-sistema (distro-aplicar-config).
# Aqui fica só o que é do pendrive e do instalador.
plymouth-set-default-theme bgrt || true

# Instalador (Calamares)
cal=/etc/calamares
if [ -d "$cal/branding/debian" ]; then
	rm -rf "$cal/branding/distro"
	cp -a "$cal/branding/debian" "$cal/branding/distro"
	cp /usr/share/icons/hicolor/scalable/apps/distro-logo.svg "$cal/branding/distro/distro-logo.svg"
	sed -E -i \
		-e 's/^componentName:.*/componentName: distro/' \
		-e "s/^(\s*(productName|shortProductName|bootloaderEntryName)):.*/\1: \"$DISTRO_NAME\"/" \
		-e "s/^(\s*(version|shortVersion)):.*/\1: \"$DISTRO_VERSION\"/" \
		-e "s/^(\s*(versionedName|shortVersionedName)):.*/\1: \"$DISTRO_NAME $DISTRO_VERSION\"/" \
		-e 's/^(\s*(productLogo|productIcon)):.*/\1: "distro-logo.svg"/' \
		"$cal/branding/distro/branding.desc"
	sed -i 's/^branding:.*/branding: distro/' "$cal/settings.conf"
else
	echo "AVISO: identidade padrão do Calamares não encontrada, mantendo a do Debian" >&2
fi

# Partições: Btrfs (permite pontos de restauração) e sem swap em disco (usamos zram)
mkdir -p "$cal/modules"
part="$cal/modules/partition.conf"
echo "Arquivos do Calamares:"
find /etc/calamares /usr/share/calamares -maxdepth 2 \( -name '*.conf' -o -type d \) 2>/dev/null | sort
if [ ! -f "$part" ]; then
	padrao=$(find /usr/share/calamares /usr/lib/calamares -name partition.conf 2>/dev/null | head -1)
	if [ -n "$padrao" ]; then
		cp "$padrao" "$part"
	else
		cat > "$part" <<'EOF'
efi:
    mountPoint: "/boot/efi"
    recommendedSize: 300MiB
    minimumSize: 32MiB
    label: "EFI"
userSwapChoices:
    - none
    - file
drawNestedPartitions: false
alwaysShowPartitionLabels: true
availableFileSystemTypes: ["btrfs", "ext4"]
EOF
	fi
fi
definir() {
	if grep -Eq "^#?\s*$1:" "$part"; then
		sed -E -i "s/^#?\s*$1:.*/$1: $2/" "$part"
	else
		echo "$1: $2" >> "$part"
	fi
}
definir defaultFileSystemType '"btrfs"'
definir initialSwapChoice none

# Atalho do instalador com o nome do sistema
echo "Atalhos do instalador:"
grep -rlE "^Exec=.*(install-debian|calamares)" /usr/share/applications /etc/skel /etc/xdg /usr/share/calamares* 2>/dev/null \
	| grep '\.desktop$' | while read -r inst; do
	echo "  $inst"
	sed -i -e '/^Name\[/d' -e '/^GenericName\[/d' -e '/^Comment\[/d' \
		-e "s/^Name=.*/Name=Instalar $DISTRO_NAME/" -e 's/^Icon=.*/Icon=distro-logo/' "$inst"
done

# Tela de boas-vindas do KDE fala de "Debian GNU/Linux": sai do sistema
apt-get purge -y plasma-welcome || true

update-initramfs -u -k all
