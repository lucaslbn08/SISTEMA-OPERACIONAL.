#!/bin/sh
# Cria um ponto de restauração (Timeshift, Btrfs) antes de instalar ou atualizar programas.
# Chamado pelo apt. No máximo um por dia; o Timeshift mantém os 5 mais recentes.

[ -d /run/live/medium ] && exit 0
[ "$(findmnt -no FSTYPE /)" = btrfs ] || exit 0
command -v timeshift >/dev/null || exit 0

estado=/var/lib/distro
hoje=$(date +%F)
[ "$(cat "$estado/ultimo-snapshot" 2>/dev/null)" = "$hoje" ] && exit 0

# Primeira vez: configura o Timeshift para o disco do sistema
if [ ! -s /etc/timeshift/timeshift.json ]; then
	disco=$(findmnt -no SOURCE / | sed 's/\[.*//')
	uuid=$(blkid -s UUID -o value "$disco")
	[ -n "$uuid" ] || exit 0
	mkdir -p /etc/timeshift
	cat > /etc/timeshift/timeshift.json <<EOF
{
  "backup_device_uuid" : "$uuid",
  "parent_device_uuid" : "",
  "do_first_run" : "false",
  "btrfs_mode" : "true",
  "include_btrfs_home_for_backup" : "false",
  "include_btrfs_home_for_restore" : "false",
  "stop_cron_emails" : "true",
  "schedule_monthly" : "false",
  "schedule_weekly" : "true",
  "schedule_daily" : "true",
  "schedule_hourly" : "false",
  "schedule_boot" : "false",
  "count_monthly" : "2",
  "count_weekly" : "2",
  "count_daily" : "5",
  "count_hourly" : "6",
  "count_boot" : "5",
  "exclude" : [],
  "exclude-apps" : []
}
EOF
fi

echo "Criando ponto de restauração antes da atualização..."
if timeshift --create --scripted --tags D --comments "Antes de atualizar" >/dev/null 2>&1; then
	mkdir -p "$estado"
	echo "$hoje" > "$estado/ultimo-snapshot"
fi
exit 0
